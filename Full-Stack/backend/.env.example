# Server configuration
HOST=localhost
PORT=3000

# Database credentials
PGUSER=your_db_username
PGPASSWORD=your_db_password
PGDATABASE=your_db_name
PGHOST=your_db_host
PGPORT=5432

# Node-pg-migrate DB URL (Used for migrations)
DATABASE_URL=postgres://your_db_username:your_db_password@your_db_host:5432/your_db_name?sslmode=no-verify

# JWT Configuration (Change these in production to long secure keys)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Model Service API Endpoint
MODEL_SERVICE_URL=http://localhost:8000

# Google Gemini API Key (Get a free key at aistudio.google.com)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
